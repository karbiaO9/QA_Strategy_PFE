# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/marketsaver?schema=public"

# Prisma Connection Pool Optimization for High Load (50k+ users)
PRISMA_CONNECTION_LIMIT=50
PRISMA_CONNECTION_TIMEOUT=30000
PRISMA_POOL_MIN=5
PRISMA_POOL_MAX=50
PRISMA_POOL_ACQUIRE=30000
PRISMA_POOL_IDLE=10000

# Server Configuration
PORT=5050
NODE_ENV=production

# Cache Configuration (Node-Cache) - Optimized for 50k users
CACHE_TTL_SECONDS=300
CACHE_CHECK_PERIOD_SECONDS=600
CACHE_MAX_KEYS=10000

# Rate Limiting - Configured for 50k concurrent users
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50000

# Performance Tuning for High Load
MAX_CONCURRENT_REQUESTS=100000
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=65000
MAX_HEADERS_COUNT=2000

# Security
CORS_ORIGIN="*"
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
