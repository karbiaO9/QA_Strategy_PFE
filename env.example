# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/marketsaver?schema=public"

# Server Configuration
PORT=5050
NODE_ENV=production

# Rate Limiting - Configured for 50k concurrent users
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50000

# Performance Tuning for High Load
MAX_CONCURRENT_REQUESTS=100000
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=65000
MAX_HEADERS_COUNT=2000

# Security
CORS_ORIGIN="*"
HELMET_ENABLED=true
COMPRESSION_ENABLED=true
