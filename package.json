{
  "name": "market-data-testing-workspace",
  "version": "1.0.0",
  "description": "XXXConnect backend API testing and reporting workspace",
  "main": "backend-testing/scripts/test-endpoints.js",
  "scripts": {
    "test:endpoints": "node backend-testing/scripts/test-endpoints.js",
    "report:newman": "node backend-testing/scripts/generate-newman-markdown.js backend-testing/reports/newman-report.json backend-testing/reports/newman-report.md",
    "test:api:auth": "newman run backend-testing/postman/XXXConnect-Identity-Sprint1-Auth.postman_collection.json -e backend-testing/postman/XXXConnect-Identity-local.postman_environment.json --reporters cli,json,html --reporter-json-export backend-testing/reports/newman/auth-results.json --reporter-html-export backend-testing/reports/newman/auth-report.html",
    "report:md": "node backend-testing/scripts/generate-md-reports-from-newman.js",
    "report:md:physio": "node backend-testing/scripts/generate-md-reports-from-newman.js backend-testing/reports/newman/physio-merged.json",
    "stc:prefill": "node backend-testing/scripts/generate-stc-prefill-from-excel.js",
    "postman:physio-backend": "node backend-testing/scripts/build-physio-postman-from-excel.js",
    "test:physio:chain": "node backend-testing/scripts/run-physio-newman-chain.js",
    "test:physio:all:report": "node backend-testing/scripts/run-all-physio-newman-and-md.js",
    "report:md:physio:full": "node backend-testing/scripts/merge-newman-chain-split-dedupe.js && node backend-testing/scripts/generate-md-reports-from-newman.js backend-testing/reports/newman/physio-chain-split-full-deduped.json",
    "test:api:auth:report": "npm run test:api:auth && npm run report:md",
    "qa:newman:md:webhook": "node backend-testing/scripts/run-newman-report-and-upload-webhook.js",
    "qa:upload-markdown:webhook": "node backend-testing/scripts/upload-markdown-webhook-only.js",
    "qa:upload-stc-bugs:webhook": "node backend-testing/scripts/upload-stc-bugs-markdown-webhook-curl.js"
  },
  "keywords": [
    "api-testing",
    "newman",
    "reporting"
  ],
  "author": "MarketSaver Team",
  "license": "MIT",
  "devDependencies": {
    "newman": "latest",
    "newman-reporter-html": "latest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
