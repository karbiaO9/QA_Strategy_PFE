{
  "name": "marketsaver-server",
  "version": "1.0.0",
  "description": "MarketSaver API Server - Serves crypto market data from cache",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test/test-api.js",
    "test:all": "node test/test-api.js",
    "test:health": "node test/run-tests.js --health",
    "test:cache": "node test/run-tests.js --cache",
    "test:api": "node test/run-tests.js --api",
    "test:perf": "node test/performance-test.js",
    "test:perf:local": "node test/performance-test.js --url http://localhost:5055",
    "test:perf:remote": "node test/performance-test.js --url https://market-server-blockstat.onrender.com",
    "test:fallback": "node test/fallback-test.js"
  },
  "keywords": [
    "crypto",
    "api",
    "markets",
    "news",
    "sentiment"
  ],
  "author": "MarketSaver Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "autocannon": "^8.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-slow-down": "^2.0.1",
    "fastify": "^5.5.0",
    "helmet": "^7.2.0",
    "http-proxy": "^1.18.1",
    "node-cron": "^3.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "axios": "^1.11.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
