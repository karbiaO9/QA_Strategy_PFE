# ---- HTTP ----
PORT=3001
SEED_ON_BOOT=false
SEED_RESET=false

# ---- MongoDB ----
# [REQUIRED] 
MONGODB_URI=mongodb://localhost:27017/physio_identity

# ---- JWT ----
# [REQUIRED] 
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
JWT_INVITATION_TTL=7d
JWT_INVITATION_TTL_SECONDS=604800

# ---- Bcrypt ----
BCRYPT_ROUNDS=12
RESET_CODE_BCRYPT_ROUNDS=10

# ---- Password reset (Redis-backed) ----
RESET_CODE_TTL_SECONDS=600
RESET_TOKEN_TTL_SECONDS=600
RESET_MAX_ATTEMPTS=3

# ---- Rate limiting  ----
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_FORGOT_WINDOW_SECONDS=3600

# ---- CASL permissions cache ----
PERMS_CACHE_TTL_SECONDS=3600

# ---- Refresh token ----
REFRESH_TOKEN_TTL_SECONDS=604800

# ---- Freemium windows (days) ----
FREEMIUM_STUDENT_DAYS=90
FREEMIUM_TRIAL_DAYS=30

# ---- RabbitMQ ----
# [REQUIRED] 
RABBITMQ_URL=amqp://localhost:5672

# ---- Redis  ----
REDIS_URL=redis://localhost:6379

# ---- Frontend base URL  ----
# [REQUIRED] 
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_INVITATION_PATH=/kine/accept-invitation

# --- SMTP mail delivery (SendGrid) ---
MAIL_DRIVER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=apikey
MAIL_PASSWORD=
MAIL_FROM=XXX & Connect <noreply@your-verified-domain.com>

# --- Backend public URL ---
BACKEND_PUBLIC_URL=

# ---- File uploads ----
UPLOAD_MAX_BYTES=5242880

# [REQUIRED] 
STORAGE_PROVIDER=ovh-hds

# [REQUIRED] 
S3_REGION=gra
S3_BUCKET=physioconnect-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

#   S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_ENDPOINT=
S3_ENDPOINT_DOCKER=

S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=
S3_USE_PRESIGNED_GET=true
S3_PRESIGNED_GET_TTL_SECONDS=900

S3_SSE=

# ─── OAuth Google (patient mobile login) ─────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/patient/auth/google/callback

# GOOGLE_ALLOWED_AUDIENCES=

