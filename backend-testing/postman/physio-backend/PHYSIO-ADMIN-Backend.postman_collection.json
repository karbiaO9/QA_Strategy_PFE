    {
      "name": "Prerequisite",
      "description": "Kine nominal login (STC-AUTH-KINE-001/B) — sets kineId, cabinetId, profileId, kineToken before admin routes that target a kine.",
      "item": [
        {
          "name": "STC-AUTH-KINE-001/B | Kine login nominal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/kine/auth/login",
            "description": "**ClickUp:** BE-C1-01\n**User Story:** US-C.1\n**Expected (sheet):** Cas nominal validé selon les AC du ticket :   • POST /api/v1/kine/auth/login accepte {email, password}   • Vérification password contre le hash bcrypt   • Retour accessToken (TTL court) + refreshToken (TTL long)   • Reto...",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{kineEmail}}\",\n  \"password\": \"{{kinePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// STC: STC-AUTH-KINE-001/B",
                  "pm.test('[STC-AUTH-KINE-001/B] response time OK', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});",
                  "pm.test('[STC-AUTH-KINE-001/B] status 200 or 201', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "var json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  var at = json.accessToken || json.access_token || (json.data && json.data.accessToken);",
                  "  var rt = json.refreshToken || json.refresh_token || (json.data && json.data.refreshToken);",
                  "  if (at) {",
                  "    pm.environment.set('kineToken', at);",
                  "  }",
                  "  if (rt) pm.environment.set('refreshToken', rt);",
                  "  if (json.user && json.user.id) pm.environment.set('kineId', json.user.id);",
                  "  var p0 = json.profiles && json.profiles[0];",
                  "  if (p0 && p0.id) pm.environment.set('profileId', p0.id);",
                  "  if (p0 && p0.cabinetId) pm.environment.set('cabinetId', p0.cabinetId);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
