                  "});",
                  "pm.test('[STC-VERIF-006/B] status 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "var json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "pm.test('[STC-VERIF-006/B] error code REJECTION_REASON_REQUIRED or VALIDATION_FAILED if body exposes code', function () {",
                  "  if (json && json.code != null && json.code !== '') {",
                  "    pm.expect(['REJECTION_REASON_REQUIRED', 'VALIDATION_FAILED']).to.include(String(json.code));",
                  "  }",
