        {
          "name": "STC-VERIF-006/B | Verification reject validation 400",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/v1/kines/{{kineId}}/verification",
            "description": "**ClickUp:** BE-I1-01\n**User Story:** US-I.1\n**Expected (sheet):** • HTTP 400 Bad Request • Body: { statusCode: 400, code: 'REJECTION_REASON_REQUIRED' } • verificationStatus reste inchangé",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"REJECT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// STC: STC-VERIF-006/B",
                  "pm.test('[STC-VERIF-006/B] response time OK', function () {",
