                  "  pm.expect([201, 400, 403, 409]).to.include(pm.response.code);",
                  "});",
                  "var json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "if (pm.response.code === 201) {",
                  "  var tok = json.invitationToken || json.token || (json.data && (json.data.invitationToken || json.data.token));",
                  "  if (tok) pm.collectionVariables.set('invitationTokenMismatch', tok);",
                  "}"
