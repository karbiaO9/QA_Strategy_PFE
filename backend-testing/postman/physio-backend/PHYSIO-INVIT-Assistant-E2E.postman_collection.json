{
  "info": {
    "name": "PHYSIO - INVIT Assistant E2E + STC chain",
    "_postman_id": "physio-invit-assistant-e2e-001",
    "description": "End-to-end: login as cabinet kine admin, invite ASSISTANT to {{inviteAssistantTargetEmail}} (default oussemak9999@gmail.com), then exercise invitation STCs.\n\n**Credentials:** Set collection or environment variables `kineAdminEmail` and `kineAdminPassword` (e.g. password containing `KineAdmin123` as you use in QA).\n\n**Run order:** Use Collection Runner top-to-bottom. Negative accept/preview cases are placed before nominal accept so the assistant token stays valid until STC-INVIT-ACCEPT-001/B.\n\n**STC-INVIT-GEN-008/B, STC-INVIT-ACCEPT-003/004/008/B:** Not present in the checked Excel export; requests follow the same API patterns as the main KINE collection (GEN-008 = invalid generate payload 400; ACCEPT-003 = replay after consume 409; ACCEPT-004 = INVITATION_ACCOUNT_MISMATCH when applicable; ACCEPT-008 = CGU rejected 400). Adjust expectations in Tests if your sheet differs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://identity.physio.agregatech.com" },
    { "key": "kineAdminEmail", "value": "sophie.martin@cabinet-paris.fr" },
    { "key": "kineAdminPassword", "value": "KineAdmin123!" },
    { "key": "inviteAssistantTargetEmail", "value": "oussemak9999@gmail.com" },
    { "key": "inviteMemberEmailForStc", "value": "jean.nouveau.member@testmail.fr" },
    { "key": "acceptInviteFirstName", "value": "Oussema9999" },
    { "key": "acceptInviteLastName", "value": "Invitee" },
    { "key": "acceptInvitePassword", "value": "QaTest123!" },
    { "key": "testProfessionalNumberNew", "value": "12345678901" },
    { "key": "patientEmail", "value": "marie.durand@patient.fr" },
    { "key": "invitationTokenMember", "value": "" },
    { "key": "invitationTokenAssistant", "value": "" },
    { "key": "invitationTokenConsumed", "value": "" }
  ],
  "item": [
    {
      "name": "01 Setup",
      "item": [
        {
          "name": "Login Kine Admin (cabinet) — prerequisite",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/v1/kine/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{kineAdminEmail}}\",\n  \"password\": \"{{kineAdminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Sets `kineToken`, `cabinetId`, `profileId` on success. Override `kineAdminEmail` / `kineAdminPassword` for your KineAdmin123 account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login response time OK', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});",
                  "pm.test('Login 200 or 201', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "var json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  var at = json.accessToken || json.access_token || (json.data && json.data.accessToken);",
                  "  if (at) pm.environment.set('kineToken', at);",
                  "  var p0 = json.profiles && json.profiles[0];",
                  "  if (p0 && p0.id) pm.environment.set('profileId', p0.id);",
                  "  if (p0 && p0.cabinetId) pm.environment.set('cabinetId', p0.cabinetId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 MEMBER token (STC-INVIT-GEN-001/002/007)",
      "item": [
        {
          "name": "STC-INVIT-GEN-001/B | Generate MEMBER invitation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{kineToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/kine/auth/invitations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{inviteMemberEmailForStc}}\",\n  \"cabinetId\": \"{{cabinetId}}\",\n  \"targetProfileType\": \"MEMBER\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// STC: STC-INVIT-GEN-001/B",
                  "pm.test('[STC-INVIT-GEN-001/B] response time OK', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});",
                  "pm.test('[STC-INVIT-GEN-001/B] status 200 or 201', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "var json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  var tok = json.invitationToken || json.token || (json.data && (json.data.invitationToken || json.data.token));",
                  "  if (tok) { pm.collectionVariables.set('invitationTokenMember', tok); pm.environment.set('invitationTokenMember', tok); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "STC-INVIT-GEN-002/B | Preview MEMBER invitation token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{kineToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/kine/auth/invitations/preview",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invitationToken\": \"{{invitationTokenMember}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// STC: STC-INVIT-GEN-002/B",
                  "pm.test('[STC-INVIT-GEN-002/B] response time OK', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});",
                  "pm.test('[STC-INVIT-GEN-002/B] status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "STC-INVIT-GEN-007/B | Preview conflict 409",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{kineToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/kine/auth/invitations/preview",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invitationToken\": \"{{invitationTokenMember}}\",\n  \"email\": \"existing@example.fr\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// STC: STC-INVIT-GEN-007/B",
                  "pm.test('[STC-INVIT-GEN-007/B] response time OK', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});",
                  "pm.test('[STC-INVIT-GEN-007/B] status in [409, 200]', function () {",
                  "  pm.expect([409, 200]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
