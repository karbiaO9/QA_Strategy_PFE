              "mode": "raw",
              "raw": "{\n  \"invitationToken\": \"{{invitationTokenAssistant}}\",\n  \"firstName\": \"Sophie\",\n  \"lastName\": \"Roux\",\n  \"password\": \"{{acceptInvitePassword}}\",\n  \"passwordConfirmation\": \"{{acceptInvitePassword}}\",\n  \"cguAccepted\": true,\n  \"professionalNumber\": \"{{testProfessionalNumberNew}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
