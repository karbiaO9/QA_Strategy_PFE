      "item": [
        {
          "name": "STC-PWD-FORGOT-003/B | Forgot password unknown email 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/kine/auth/forgot-password",
            "description": "**ClickUp:** BE-F1-01\n**User Story:** US-F.1\n**Expected (sheet):** • HTTP 200 OK (toujours) • Body: { message: 'Si un account existe, un code a été envoyé.' } • Email INEXISTANT : aucun email envoyé • Email EXISTANT : email envoyé silencieusement • Impossibilité d'énumérer les emails ex...",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmailNew}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// STC: STC-PWD-FORGOT-003/B",
                  "pm.test('[STC-PWD-FORGOT-003/B] response time OK', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});",
                  "pm.test('[STC-PWD-FORGOT-003/B] status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = {}; try { json = pm.response.json(); } catch (e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "STC-PWD-FORGOT-004/B | Forgot password rate limit 429",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/kine/auth/forgot-password",
            "description": "**ClickUp:** BE-F1-01\n**User Story:** US-F.1\n**Expected (sheet):** • Appels 1-5 : HTTP 200 OK • Appel 6+ : HTTP 429 Too Many Requests • Body: { statusCode: 429, code: 'RATE_LIMIT_EXCEEDED' } • Reset après 1h",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmailExisting}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// STC: STC-PWD-FORGOT-004/B",
                  "pm.test('[STC-PWD-FORGOT-004/B] response time OK', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});",
                  "pm.test('[STC-PWD-FORGOT-004/B] status 200 (early) or 429 (after repeated calls)', function () {",
                  "  pm.expect([200, 429]).to.include(pm.response.code);",
                  "});",
                  "// Run this request 6+ times quickly to assert 429 + RATE_LIMIT_EXCEEDED per sheet.",
                  "var json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "if (pm.response.code === 429) {",
                  "  pm.test('[STC-PWD-FORGOT-004/B] rate limit code', function () {",
                  "    var c = json.code || (json.body && json.body.code) || (json.error && json.error.code);",
                  "    pm.expect(String(c || '')).to.eql('RATE_LIMIT_EXCEEDED');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
