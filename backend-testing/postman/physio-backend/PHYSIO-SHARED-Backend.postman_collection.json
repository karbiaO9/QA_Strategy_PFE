    {
      "name": "Password Verify Code",
      "item": [
        {
          "name": "STC-PWD-VERIFY-001/B | Verify code success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
