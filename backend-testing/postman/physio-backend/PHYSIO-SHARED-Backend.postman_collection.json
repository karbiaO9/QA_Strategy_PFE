              }
            ],
            "url": "{{baseUrl}}/api/v1/kine/auth/verify-code",
            "description": "**ClickUp:** BE-F2-01\n**User Story:** US-F.2\n**Expected (sheet):** 200 OK or contract success response; resetToken returned; code marked as consumed/verified according to backend behavior.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{kineEmail}}\",\n  \"code\": \"{{verificationCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// STC: STC-PWD-VERIFY-001/B",
                  "pm.test('[STC-PWD-VERIFY-001/B] response time OK', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});",
                  "pm.test('[STC-PWD-VERIFY-001/B] status in [200, 400] (implementation may differ)', function () {",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "var json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "if (pm.response.code === 200) {",
                  "  var rt = json.resetToken || json.reset_token || (json.data && json.data.resetToken);",
                  "  if (rt) pm.environment.set('resetToken', rt);",
                  "}"
                ]
              }
            }
          ]
