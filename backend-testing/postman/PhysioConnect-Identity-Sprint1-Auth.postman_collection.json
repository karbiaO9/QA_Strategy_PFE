    {
      "name": "STC-AUTH-006B - Refresh / Profile Behavior",
      "item": [
        {
          "name": "STC-AUTH-006B - Kine refresh token flow",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{kine_refresh_token}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/kine/auth/refresh",
            "description": "User Story: US-C.2\nWarning: STC description is about Patient single-profile login, but endpoint mapping is Kine refresh. Validate mapping with Swagger/Postman before final reporting."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var rt = pm.environment.get('kine_refresh_token') || '';",
                  "pm.test('Refresh token is provided for this test', function () {",
                  "  pm.expect(rt).to.not.eql('');",
                  "});",
                  "pm.test('Status code is 200 when refresh token is valid', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = {};",
                  "try { body = pm.response.json(); } catch (e) { body = {}; }",
                  "var token = body.accessToken || body.access_token || body.token || (body.data && (body.data.accessToken || body.data.access_token || body.data.token));",
                  "if (token) pm.environment.set('kine_access_token', token);",
                  "pm.test('New access token exists', function () {",
                  "  pm.expect(token || '').to.not.eql('');",
                  "});",
                  "pm.test('No password or sensitive data leakage', function () {",
                  "  var txt = JSON.stringify(body).toLowerCase();",
                  "  pm.expect(txt).to.not.include('password');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "STC-AUTH-010B - Admin Login / Endpoint Mapping Check",
      "item": [
        {
          "name": "STC-AUTH-010B - Safe negative change-password check",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{kine_access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"WrongPassword123!\",\n  \"newPassword\": \"Temporary123!\",\n  \"confirmPassword\": \"Temporary123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/kine/auth/change-password",
            "description": "User Story: US-C.4\nWarning: STC description is Admin login, but endpoint mapping is Kine change-password. This request is kept safe by using an invalid current password."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Safe negative test returns 400 or 401', function () {",
                  "  pm.expect([400, 401]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Response confirms password was not changed', function () {",
                  "  var text = pm.response.text().toLowerCase();",
                  "  pm.expect(text).to.not.include('password changed successfully');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "STC-AUTH-010B - Admin login validation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/v1/auth/login",
            "description": "User Story: US-C.4\nExpected behavior: successful admin login and ADMIN/SUPER_ADMIN role validation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = {};",
                  "try { body = pm.response.json(); } catch (e) { body = {}; }",
                  "var token = body.accessToken || body.access_token || body.token || (body.data && (body.data.accessToken || body.data.access_token || body.data.token));",
                  "if (token) pm.environment.set('admin_access_token', token);",
                  "pm.test('Token exists', function () {",
                  "  pm.expect(token || '').to.not.eql('');",
                  "});",
                  "",
                  "function decodeJwt(payloadToken) {",
                  "  try {",
                  "    var payload = payloadToken.split('.')[1];",
                  "    payload = payload.replace(/-/g, '+').replace(/_/g, '/');",
                  "    var json = decodeURIComponent(atob(payload).split('').map(function(c) {",
                  "      return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);",
                  "    }).join(''));",
                  "    return JSON.parse(json);",
                  "  } catch (e) { return null; }",
                  "}",
                  "",
                  "var roleBody = body.role || (body.user && body.user.role) || (body.data && (body.data.role || (body.data.user && body.data.user.role)));",
                  "var jwtPayload = token ? decodeJwt(token) : null;",
                  "var roleToken = jwtPayload && (jwtPayload.role || (jwtPayload.roles && jwtPayload.roles[0]));",
                  "var role = (roleBody || roleToken || '').toString().toUpperCase();",
                  "pm.test('ADMIN or SUPER_ADMIN role exists', function () {",
                  "  pm.expect(role).to.match(/ADMIN|SUPER_ADMIN/);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
